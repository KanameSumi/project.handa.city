---
import site from "virtual:cosense-site-kit/site";
import options from "virtual:cosense-theme-default/options";
import { path } from "@cosense-site-kit/theme-utils";
import { loadStructure } from "../lib/config";
import KaTeXLink from "@cosense-site-kit/theme-utils/components/KaTeXLink.astro";
import { resolveActiveSkin } from "../presets";
import { ogImageFor } from "../lib/og";
import CodeBlockEnhancer from "./CodeBlockEnhancer.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Lightbox from "./Lightbox.astro";
import LinkPreview from "./LinkPreview.astro";
import SearchOverlay from "./SearchOverlay.astro";
import Splash from "./Splash.astro";
import PanelScrollbar from "./PanelScrollbar.astro"; // HAnDA: 白いパネルの右端のスクロールバー
import TableOfContents from "./TableOfContents.astro";
import "../styles/global.css";
import "../styles/handa.css";

interface Props {
  title: string;
  description?: string;
  /** Hide the floating right-side TOC (use on home / archive / tag pages). */
  hideToc?: boolean;
  /** OG/Twitter card image (absolute or site-relative). Falls back to favicon. */
  image?: string;
  /** OpenGraph type. "article" for content pages, "website" for indexes. */
  ogType?: "website" | "article";
}

const { title, description, hideToc = false, image, ogType = "website" } = Astro.props;

const siteTitle =
  options.siteTitle ?? site?.title ?? (Astro.site ? new URL("/", Astro.site).hostname : title);
const fullTitle = siteTitle && siteTitle !== title ? `${title} | ${siteTitle}` : title;
const metaDescription = description ?? site?.description ?? "";
const lang = site?.lang ?? "ja";

// SEO/social. canonical + og:url come from the current path against the
// configured site origin; og:image resolves to absolute (page image, else the
// favicon). Built here so every template that uses Layout gets cards for free.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// HAnDA: public/ のファイルを指すときの頭（GitHub Pages のサブパスにも対応）
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// SNS で共有されたときの画像：ページの画像 → 無ければロゴ
// 写真の無いページは、ビルド時に作る共有用の画像（lib/og.ts）を使う
const ogGenerated = image ? undefined : await ogImageFor(Astro.url.pathname);
const imageSrc = image ?? ogGenerated ?? `${base}/favicon-512.png`;
const ogImage = imageSrc && Astro.site ? new URL(imageSrc, Astro.site).href : imageSrc;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "Article" : "WebSite",
  name: title,
  headline: title,
  ...(metaDescription ? { description: metaDescription } : {}),
  ...(canonical ? { url: canonical } : {}),
  ...(ogImage ? { image: ogImage } : {}),
};

// Preset (skin) support. The active skin comes from `.site` YAML `theme.skin`
// (operator-controlled, switchable in Cosense with no repo edit) and falls back
// to the preset wired in astro.config.ts. Token overrides go on the <html>
// inline style so they beat the :root defaults in global.css regardless of
// stylesheet order; fonts are preset-driven (they load via a <link>).
const structure = await loadStructure();
const { tokens, colorScheme, fontHref } = resolveActiveSkin(structure.theme?.skin, options);
// Only advertise the feed when the site actually declares a posts tag.
const hasFeed = Boolean(structure.posts?.tag);
const htmlStyle = [
  colorScheme ? `color-scheme:${colorScheme}` : null,
  ...Object.entries(tokens).map(([k, v]) => `${k}:${v}`),
]
  .filter(Boolean)
  .join(";");
---
<!doctype html>
<html lang={lang} data-theme={colorScheme ?? undefined} style={htmlStyle || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {metaDescription && <meta name="description" content={metaDescription} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {/* HAnDA: タブのアイコンはロゴ（public/favicon.ico・favicon-512.png・apple-touch-icon.png）
        アイコンを差し替えたら ?v= の数字を上げる（ブラウザ、特に Safari が古いアイコンを覚えているため） */}
    <link rel="icon" href={`${base}/favicon.ico?v=3`} sizes="48x48" />
    <link rel="icon" href={`${base}/favicon-512.png?v=3`} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png?v=3`} />
    {hasFeed && (
      <link rel="alternate" type="application/rss+xml" title={`${siteTitle} feed`} href={path("feed.xml")} />
    )}

    {/* OpenGraph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:site_name" content={siteTitle} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter card — only go large when the page has its own image (not the
        favicon fallback), otherwise a small summary card. */}
    <meta name="twitter:card" content={image || ogGenerated ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Escape "<" so remote page titles can't close the script tag (XSS). */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} is:inline />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {fontHref ? (
      <link href={fontHref} rel="stylesheet" />
    ) : (
      <link
        href="https://fonts.googleapis.com/css2?family=M+PLUS+2:wght@400;500;700&family=M+PLUS+1+Code:wght@400;500&display=swap"
        rel="stylesheet"
      />
    )}
    <KaTeXLink />
    <title>{fullTitle}</title>

    {/* HAnDA: 画面遷移の向き。メニューで右のページへ進むときは中身が右から、
        左（ホーム側）へ戻るときは左から入ってくる。ヘッダーを読み終えるまで
        最初の描画を待たせて、メニューの並び順を読めるようにしている */}
    <link rel="expect" href="#site-nav-wrap" blocking="render" />
    {/* HAnDA: マウスで操作する環境では、ブラウザのスクロールバーを隠して
        白いパネルの右端に自前のスクロールバーを出す（components/PanelScrollbar.astro）。
        最初の表示より前に決めて、ページが横にずれないようにする */}
    <script is:inline>
      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        document.documentElement.classList.add("has-panel-scroll");
      }
    </script>
    <script is:inline>
      (function () {
        function home() {
          var b = document.querySelector(".site-brand");
          return new URL(b ? b.href : "/", location.href).pathname;
        }
        // そのページがメニューの何番目の区画か（ホームは -1、どれでもなければ null）
        function section(path) {
          if (path === home()) return -1;
          var best = null, len = -1;
          document.querySelectorAll(".site-nav a").forEach(function (a, i) {
            var p = new URL(a.href, location.href).pathname.replace(/\/$/, "");
            if (!p) return;
            if ((path === p || path.indexOf(p + "/") === 0) && p.length > len) {
              best = i;
              len = p.length;
            }
          });
          return best;
        }
        function depth(p) {
          return p.split("/").filter(Boolean).length;
        }
        function direction(from, to) {
          var a = new URL(from).pathname, b = new URL(to).pathname;
          if (a === b) return null;
          var i = section(a), j = section(b);
          if (i !== null && j !== null && i !== j) return j > i ? "forward" : "backward";
          if (depth(a) !== depth(b)) return depth(b) > depth(a) ? "forward" : "backward";
          return null;
        }
        function addType(vt, d) {
          if (vt && d && vt.types && vt.types.add) vt.types.add(d);
        }
        // 前のページ側。離れる直前に vt-old を付けて、中身の名前を「前のページ用」に変える
        window.addEventListener("pageswap", function (e) {
          if (!e.viewTransition) return;
          document.documentElement.classList.add("vt-old");
          var to = e.activation && e.activation.entry && e.activation.entry.url;
          if (to) addType(e.viewTransition, direction(location.href, to));
        });
        // 「戻る」でキャッシュから復元されたときは元に戻す
        window.addEventListener("pageshow", function (e) {
          if (e.persisted) document.documentElement.classList.remove("vt-old");
        });
        // 次のページ側
        window.addEventListener("pagereveal", function (e) {
          var act = window.navigation && navigation.activation;
          var from = act && act.from && act.from.url;
          if (!from || act.navigationType === "reload") return;
          if (new URL(from).origin !== location.origin) return;
          addType(e.viewTransition, direction(from, location.href));
          var html = document.documentElement;
          var arrive = function () {
            html.classList.remove("vt-wait");
            html.classList.add("is-arriving");
            setTimeout(function () { html.classList.remove("is-arriving"); }, 800);
          };
          if (!e.viewTransition) return arrive();
          // 画面に見えている写真が読み込み終わるまで、次の中身を出さずに待つ
          // （写真が後からパッと出てちらつくのを防ぐ）。長くても WAIT_MAX ミリ秒で出す
          var WAIT_MAX = 700;
          html.classList.add("vt-wait");
          var done = false;
          var go = function () { if (!done) { done = true; arrive(); } };
          setTimeout(go, WAIT_MAX);
          var check = function () {
            var imgs = [].slice.call(document.querySelectorAll(".site-main img")).filter(function (img) {
              var r = img.getBoundingClientRect();
              if (r.width === 0 || r.bottom < 0 || r.top > innerHeight) return false;
              return getComputedStyle(img).opacity !== "0"; // 裏で待機中のスライドは除く
            });
            Promise.all(imgs.map(function (img) {
              if (img.complete) return img.decode ? img.decode().catch(function () {}) : null;
              return new Promise(function (ok) {
                img.addEventListener("load", ok, { once: true });
                img.addEventListener("error", ok, { once: true });
              });
            })).then(go);
          };
          if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", check);
          else check();
        });
      })();
    </script>
  </head>
  <body>
    {/* HAnDA: 最初に開いたときのロード画面 */}
    <Splash />
    <Header currentPath={Astro.url.pathname} />
    {options.search && <SearchOverlay />}
    <main class="site-main"><slot /></main>
    <Footer />
    {!hideToc && <TableOfContents />}
    <CodeBlockEnhancer />
    <LinkPreview />
    <Lightbox />
    <PanelScrollbar />
  </body>
</html>
