---
// HAnDA: 最初にサイトを開いたときのロード画面（ロゴのアニメーション）。
// ロゴの文字（H・A・n・D・A・レンガ）が、レンガを積むように上から順に落ちてきて並ぶ。
// - 同じタブでは最初の 1 回だけ表示（ページを移動するたびには出ない）
// - OS の「視差効果を減らす」設定の人には表示しない
// - JS が動かなくても 4 秒で自動的に消える
// 画像は public/splash/ にある（ロゴを文字ごとに切り出したもの）
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// 各パーツの横位置と幅（ロゴ全体に対する %）
const pieces = [
  { left: 0, width: 14.843 },
  { left: 17.494, width: 14.795 },
  { left: 34.94, width: 13.687 },
  { left: 49.687, width: 14.843 },
  { left: 67.181, width: 14.795 },
  { left: 85.205, width: 14.795 },
];
---
<script is:inline>
  // 表示前に判定して、不要ならスプラッシュを最初から出さない（ちらつき防止）
  // 「もう見た」の記録は sessionStorage に残すが、プレビュー環境などでは
  // sessionStorage が使えない・消えることがあるので、次の 2 つでも判定する
  // - 同じサイト内のリンクから来た（メニューで移動した）とき
  // - window.name の印（同じタブなら、ページを移動しても残る）
  (function () {
    var skip = false;
    try {
      skip = sessionStorage.getItem("handa-splash") === "1";
    } catch (e) {}
    try {
      if (document.referrer && new URL(document.referrer).origin === location.origin) skip = true;
    } catch (e) {}
    if (/(^|\s)handa-splash(\s|$)/.test(window.name || "")) skip = true;
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) skip = true;
    if (skip) document.documentElement.classList.add("no-splash");
  })();
</script>

<div class="splash" id="handa-splash" aria-hidden="true">
  <div class="splash-inner">
    <div class="splash-logo">
      {pieces.map((p, i) => (
        <img
          class="splash-piece"
          src={`${base}/splash/piece${i + 1}.png`}
          alt=""
          style={`left:${p.left}%;width:${p.width}%;animation-delay:${0.12 + i * 0.1}s`}
        />
      ))}
    </div>
    <img class="splash-sub" src={`${base}/splash/subtitle.png`} alt="" />
    <div class="splash-bar"><span></span></div>
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById("handa-splash");
    if (!el || document.documentElement.classList.contains("no-splash")) {
      if (el) el.remove();
      return;
    }
    try {
      sessionStorage.setItem("handa-splash", "1");
    } catch (e) {}
    try {
      if (!/(^|\s)handa-splash(\s|$)/.test(window.name || "")) {
        window.name = ((window.name || "") + " handa-splash").trim();
      }
    } catch (e) {}
    var start = Date.now();
    var MIN = 1700; // アニメーションを見せる最短時間（ミリ秒）
    function hide() {
      var wait = Math.max(0, MIN - (Date.now() - start));
      setTimeout(function () {
        el.classList.add("is-done");
        setTimeout(function () { el.remove(); }, 700);
      }, wait);
    }
    if (document.readyState === "complete") hide();
    else window.addEventListener("load", hide, { once: true });
  })();
</script>

<style is:global>
  html.no-splash .splash { display: none; }
  .splash {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--color-bg, #fff);
    transition: opacity 0.6s cubic-bezier(0.16, 0.84, 0.44, 1), transform 0.6s cubic-bezier(0.16, 0.84, 0.44, 1);
    /* JS が動かなかったときの保険：4 秒で消える */
    animation: splash-failsafe 0.4s ease 4s forwards;
  }
  .splash.is-done {
    opacity: 0;
    transform: translateY(-24px);
    pointer-events: none;
  }
  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    width: min(440px, 76vw);
  }
  .splash-logo {
    position: relative;
    width: 100%;
    aspect-ratio: 2075 / 344;
  }
  .splash-piece {
    position: absolute;
    top: 0;
    height: 100%;
    opacity: 0;
    transform: translateY(-70%);
    animation: splash-drop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  .splash-sub {
    width: 100%;
    height: auto;
    opacity: 0;
    animation: splash-fade 0.5s ease 0.85s forwards;
  }
  .splash-bar {
    width: 38%;
    height: 3px;
    border-radius: 3px;
    background: var(--color-border, #e8e8ec);
    overflow: hidden;
  }
  .splash-bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-accent, #d6152e);
    transform-origin: left;
    transform: scaleX(0);
    animation: splash-bar 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards;
  }
  @keyframes splash-drop {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes splash-fade {
    to { opacity: 1; }
  }
  @keyframes splash-bar {
    to { transform: scaleX(1); }
  }
  @keyframes splash-failsafe {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>
