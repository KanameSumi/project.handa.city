---
// HAnDA: トップページのスライドショー（写真がゆっくりズームしながら、フェードで切り替わる）。
// 写真は Cosense の「トップ写真」ページから読む（lib/slides.ts）。
interface Props {
  slides: string[];
  caption?: string;
  /** 1 枚あたりの表示時間（ミリ秒） */
  interval?: number;
}
const { slides, caption, interval = 5500 } = Astro.props;
---
<section class="hero-slides" data-interval={interval} aria-label="プロジェクトの写真">
  {slides.map((src, i) => (
    <img
      class:list={["hero-slide", { "is-active": i === 0 }]}
      src={src}
      alt=""
      loading={i === 0 ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={i === 0 ? "high" : "auto"}
    />
  ))}
  <div class="hero-shade" aria-hidden="true"></div>
  {caption && <p class="hero-caption">{caption}</p>}
  {slides.length > 1 && (
    <div class="hero-dots" role="tablist" aria-label="写真の切り替え">
      {slides.map((_, i) => (
        <button type="button" class:list={["hero-dot", { "is-active": i === 0 }]} aria-label={`${i + 1}枚目`} data-index={i}></button>
      ))}
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>(".hero-slides").forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLImageElement>(".hero-slide")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>(".hero-dot")];
    if (slides.length < 2) return;
    const interval = Number(root.dataset.interval) || 5500;
    let current = 0;
    let timer: number | undefined;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle("is-active", k === current));
      dots.forEach((d, k) => d.classList.toggle("is-active", k === current));
    };
    const start = () => {
      stop();
      timer = window.setInterval(() => show(current + 1), interval);
    };
    const stop = () => window.clearInterval(timer);
    dots.forEach((d) => d.addEventListener("click", () => { show(Number(d.dataset.index)); start(); }));
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    start();
  });
</script>

<style>
  .hero-slides {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 8;
    max-height: 72vh;
    width: 100%;
    background: #1d1d22;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.0);
    transition: opacity 1.4s ease, transform 7s linear;
  }
  .hero-slide.is-active {
    opacity: 1;
    transform: scale(1.07);
  }
  .hero-shade {
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent);
    pointer-events: none;
  }
  .hero-caption {
    position: absolute;
    left: 2.5rem;
    right: 8rem;
    bottom: 1.75rem;
    margin: 0;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }
  .hero-dots {
    position: absolute;
    right: 2rem;
    bottom: 1.9rem;
    display: flex;
    gap: 0.5rem;
  }
  .hero-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 1.5px solid #fff;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    opacity: 0.85;
  }
  .hero-dot.is-active { background: #fff; }
  @media (max-width: 720px) {
    .hero-slides { aspect-ratio: 4 / 3; }
    .hero-caption { left: 1.25rem; right: 1.25rem; bottom: 2.6rem; font-size: 0.9rem; }
    .hero-dots { left: 1.25rem; right: auto; bottom: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide, .hero-slide.is-active { transform: none; transition: opacity 0.8s ease; }
  }
</style>
