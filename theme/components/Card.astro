---
// HAnDA: ブログ記事・活動のカード（画像＋タイトル＋説明＋日付）。
// 一覧ページとトップページで共通。親で <ul class="card-grid"> に入れて使う。
import type { CollectionEntry } from "astro:content";
import { formatDate, path, vtName } from "@cosense-site-kit/theme-utils";

interface Props {
  entry: CollectionEntry<"pages">;
  /** 絞り込み用のカテゴリ（活動・成果ページで使う） */
  cats?: string[];
  /** 日付を出すか（活動・成果では出さない） */
  showDate?: boolean;
}
const { entry, cats, showDate = true } = Astro.props;
const { slug, image, title, summary, publishedAt } = entry.data;
---
<li class="card" data-cats={cats ? `|${cats.join("|")}|` : undefined}>
  <a href={path(slug)} class="card-link">
    <div class="card-thumb" style={image ? `view-transition-name:${vtName(slug)}` : undefined}>
      {image
        ? <img src={image} alt="" loading="lazy" decoding="async" />
        : <span class="card-placeholder" aria-hidden="true">{Array.from(title.trim())[0] ?? "·"}</span>}
    </div>
    <div class="card-body">
      {showDate && publishedAt && <time class="card-date" datetime={publishedAt}>{formatDate(publishedAt)}</time>}
      <span class="card-title">{title}</span>
      {summary && <span class="card-summary">{summary}</span>}
    </div>
  </a>
</li>

<style is:global>
  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
  }
</style>
<style>
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg);
    transition: border-color 0.15s var(--ease), transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .card-link:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.06);
  }
  .card-thumb {
    aspect-ratio: 16 / 10;
    background: var(--color-bg-soft);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-placeholder {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--color-text-faint);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 1rem 1rem;
  }
  .card-date {
    font-family: "Oswald", var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .card-title {
    font-weight: 700;
    line-height: 1.45;
  }
  .card-summary {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
