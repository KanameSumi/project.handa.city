---
// HAnDA: ブログ記事・活動のカード（画像＋タイトル＋説明＋日付）。
// 一覧ページとトップページで共通。親で <ul class="card-grid"> に入れて使う。
import type { CollectionEntry } from "astro:content";
import { formatDate, path, vtName } from "@cosense-site-kit/theme-utils";

interface Props {
  entry: CollectionEntry<"pages">;
  /** 絞り込み用のカテゴリ（活動・成果ページで使う） */
  cats?: string[];
  /** 日付を出すか（活動・成果では出さない） */
  showDate?: boolean;
}
const { entry, cats, showDate = true } = Astro.props;
const { slug, image, title, summary, publishedAt } = entry.data;
// 画像が無いときはロゴ（ロゴセットの丸型2 を切り抜いたもの：public/card-placeholder.png）を小さく出す
const placeholderSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/card-placeholder.png`;
---
<li class="card" data-cats={cats ? `|${cats.join("|")}|` : undefined}>
  <a href={path(slug)} class="card-link">
    <div class="card-thumb" style={image ? `view-transition-name:${vtName(slug)}` : undefined}>
      {image
        ? <img src={image} alt="" loading="lazy" decoding="async" />
        : <img class="card-placeholder" src={placeholderSrc} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
    </div>
    <div class="card-body">
      {showDate && publishedAt && <time class="card-date" datetime={publishedAt}>{formatDate(publishedAt)}</time>}
      <span class="card-title">{title}</span>
      {summary && <span class="card-summary">{summary}</span>}
    </div>
  </a>
</li>

<style is:global>
  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 540px) {
    .card-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
<style>
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg);
    transition: border-color 0.15s var(--ease), transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .card-link:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.06);
  }
  .card-thumb {
    aspect-ratio: 16 / 10;
    background: var(--color-bg-soft);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-thumb img.card-placeholder {
    width: auto;
    height: 2.6rem;
    opacity: 0.9;
    object-fit: contain;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 1rem 1rem;
  }
  .card-date {
    font-family: "Oswald", var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .card-title {
    font-weight: 700;
    line-height: 1.45;
  }
  .card-summary {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* スマホ：横並びの短いカード（左に小さい画像、右に文字） */
  @media (max-width: 540px) {
    .card-link {
      flex-direction: row;
      align-items: stretch;
    }
    .card-link:hover { transform: none; }
    .card-thumb {
      flex: 0 0 34%;
      max-width: 8.5rem;
      aspect-ratio: auto;
      min-height: 5.75rem;
    }
    .card-thumb img.card-placeholder { height: 1.9rem; }
    .card-body {
      flex: 1;
      min-width: 0;
      justify-content: center;
      gap: 0.2rem;
      padding: 0.65rem 0.85rem;
    }
    .card-date { font-size: 0.72rem; }
    .card-title {
      font-size: 0.95rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-summary {
      font-size: 0.78rem;
      line-height: 1.5;
      -webkit-line-clamp: 1;
    }
  }
</style>
