---
// /members — 各メンバーが Cosense に作った個人ページを自動で集約する。
// 年度タブで切り替えて表示（最初は最新年度）。複数年度にいる人も 1 人 1 枚のカードで、
// 同じ人が同時に 2 回出ることはない。
//
// メンバーページの書き方（Cosense 側）:
//   - タイトル = 名前
//   - 本文 1 行目 = 一言（役割・所属など）→ カードの説明文になる
//   - 写真を貼ると最初の 1 枚がカード画像になる
//   - タグ: #publish #member/2026 （複数年度なら #member/2025 #member/2026 と並べる）
//
// 並び順（くわしくは handa.config.ts の members）:
//   学科ごとに見出しを付けてまとめる
//   学科の中は 役職（#role/代表 #role/副代表）→ 学年の高い順 → 名前順（#yomi/すずきしょうま）
//   学科・学年は本文 1 行目（「情報科学科 ３年」など）から読み取る。
//   読み取れないときや変えたいときは #dept/情報科学科 #grade/3 のタグで指定できる
//   ※ / の入ったタグはサイト上には表示されない
import { path } from "@cosense-site-kit/theme-utils";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BackLink from "../components/BackLink.astro";
import { homeBack } from "../lib/sections";
import { sectionInfo } from "../lib/sections";
import { loadMembers, deptRank, OTHER_DEPT } from "../lib/members";

const info = await sectionInfo("members");

const members = await loadMembers();

// 学科ごとにまとめる（並び順は handa.config.ts の departments、無い学科は後ろに）
const groups = [...new Set(members.map((m) => m.dept))]
  .sort((a, b) => deptRank(a) - deptRank(b) || a.localeCompare(b, "ja"))
  .map((dept) => ({ dept, members: members.filter((m) => m.dept === dept) }));
const showHeadings = groups.length > 1 || groups[0]?.dept !== OTHER_DEPT;

const allYears = [...new Set(members.flatMap((m) => m.years))].sort((a, b) => Number(b) - Number(a));
const latest = allYears[0];

---

<Layout title={info.ja} description={info.intro} hideToc>
  <article class="members" data-pagefind-body>
    <BackLink back={homeBack()} />
    <SectionHeader en={info.en} title={info.ja} lead={info.intro} />

    {members.length === 0 && <p class="members-empty">まだメンバーが登録されていません。</p>}

    {allYears.length > 0 && (
      <div class="year-tabs" role="tablist" aria-label="年度" data-pagefind-ignore>
        {allYears.map((y) => (
          <button type="button" role="tab" class:list={["year-tab", { "is-active": y === latest }]} data-year={y} aria-selected={y === latest ? "true" : "false"}>
            {y}
          </button>
        ))}
        {allYears.length > 1 && (
          <button type="button" role="tab" class="year-tab" data-year="" aria-selected="false">ALL</button>
        )}
      </div>
    )}

    {groups.map((g) => (
      <section class="member-group" data-dept={g.dept} hidden={!g.members.some((m) => m.years.includes(latest))}>
        {showHeadings && <h2 class="member-group-title">{g.dept}</h2>}
        <ul class="members-grid">
          {g.members.map(({ entry, years, role }) => (
            <li data-years={`|${years.join("|")}|`} hidden={!years.includes(latest)}>
              <a href={path(entry.data.slug)} class="member-card">
                {entry.data.image
                  ? <img src={entry.data.image} alt="" loading="lazy" decoding="async" />
                  : (
                    // 写真が無いときは人型のアイコン
                    <span class="member-initial" aria-hidden="true">
                      <svg viewBox="0 0 64 64" fill="currentColor">
                        <circle cx="32" cy="24" r="11" />
                        <path d="M10 60c0-12.2 9.8-21 22-21s22 8.8 22 21z" />
                      </svg>
                    </span>
                  )}
                <span class="member-text">
                  <span class="member-name">{entry.data.title}{role && <span class="member-badge">{role}</span>}</span>
                  {entry.data.summary && <span class="member-summary">{entry.data.summary}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".year-tab");
  const cards = document.querySelectorAll<HTMLElement>(".members-grid > li");
  const show = (year: string) => {
    tabs.forEach((t) => {
      const on = t.dataset.year === year;
      t.classList.toggle("is-active", on);
      t.setAttribute("aria-selected", String(on));
    });
    cards.forEach((c) => {
      c.hidden = Boolean(year) && !(c.dataset.years ?? "").includes(`|${year}|`);
    });
    // その年度に誰もいない学科は見出しごと隠す
    document.querySelectorAll<HTMLElement>(".member-group").forEach((g) => {
      g.hidden = ![...g.querySelectorAll<HTMLElement>(".members-grid > li")].some((c) => !c.hidden);
    });
  };
  tabs.forEach((t) => t.addEventListener("click", () => {
    show(t.dataset.year ?? "");
    history.replaceState(null, "", t.dataset.year ? `#y${t.dataset.year}` : "#all");
  }));
  // URL の #y2025 / #all で年度を指定して開ける
  const m = location.hash.match(/^#y(\d{4})$/);
  if (m && [...tabs].some((t) => t.dataset.year === m[1])) show(m[1]);
  else if (location.hash === "#all") show("");
</script>

<style>
  .year-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.5rem 0 2rem;
  }
  .year-tab {
    padding: 0.35rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-soft);
    font-family: "Oswald", var(--font-sans);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .year-tab:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .year-tab.is-active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }

  /* 学科ごとのまとまり */
  .member-group + .member-group { margin-top: 2rem; }
  .member-group[hidden] { display: none; }
  .member-group-title {
    margin: 0 0 0.75rem;
    padding-left: 0.6rem;
    border-left: 3px solid var(--color-accent);
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* コンパクトな一覧：左に小さい丸写真、右に名前と一言 */
  .members-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.6rem;
  }
  .members-grid > li[hidden] { display: none; }
  .member-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.15s var(--ease), border-color 0.15s var(--ease);
    height: 100%;
  }
  .member-card:hover { background: var(--color-bg-hover); border-color: var(--color-accent); text-decoration: none; }
  .member-card img,
  .member-initial {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-bg-soft);
  }
  .member-initial {
    display: grid;
    place-items: end center;
    overflow: hidden;
    color: var(--color-text-faint);
  }
  .member-initial svg {
    width: 78%;
    height: 78%;
  }
  .member-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .member-name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .member-badge {
    flex: none;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-family: "Oswald", var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .member-summary {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .members-empty { color: var(--color-text-muted); }
</style>
