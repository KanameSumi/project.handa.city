---
// HAnDA: トップページ。
// ロゴと説明文のあと、.site の nav の順番どおりに各セクションの概要を並べる。
//   about   … .site home.page のページ本文をそのまま表示
//   blog    … 最新 3 件のカード
//   works   … 最新 3 件のカード
//   members … 一覧ページへのリンクだけ
//   contact … 研究室と SNS のリンク
//   page    … 1 行目の要約とリンク
// nav が空のときは、テーマ本来の「最近のページ一覧」を出す。
import { getCollection } from "astro:content";
import site from "virtual:cosense-site-kit/site";
import { hasTag } from "@cosense-site-kit/theme-utils";
import PageContent from "../components/Content.astro"; // HAnDA: 外部 URL をリンクカードにする版
import AboutBlock from "../components/AboutBlock.astro";
import AboutCard from "../components/AboutCard.astro";
import { handaConfig } from "../lib/config";
import { existsSync } from "node:fs";
import { join } from "node:path";
import Card from "../components/Card.astro";
import EntryCard from "../components/EntryCard.astro";
import HeroSlides from "../components/HeroSlides.astro";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { loadContact, serviceMark } from "../lib/contact";
import { byNewest, loadSections, postsTag, sectionInfo, worksTag } from "../lib/sections";
import { loadSlides } from "../lib/slides";
import { loadMembers, deptRank } from "../lib/members";

// トップのブログ・活動の欄に出す最大件数（横送りで見る）
const HOME_CARDS = 9;

const all = (await getCollection("pages")).sort(byNewest);
const sections = await loadSections();
const pTag = await postsTag();
const wTag = await worksTag();
const posts = pTag ? all.filter((e) => hasTag(e.data.tags, pTag)) : [];
const works = all.filter((e) => hasTag(e.data.tags, wTag));
const intros = {
  blog: (await sectionInfo("blog")).intro,
  works: (await sectionInfo("works")).intro,
  members: (await sectionInfo("members")).intro,
};

// MEMBERS 欄：最新年度のメンバーの人数・学科ごとの人数・顔ぶれ
const allMembers = await loadMembers();
const memberYear = [...new Set(allMembers.flatMap((m) => m.years))].sort().at(-1);
const yearMembers = memberYear ? allMembers.filter((m) => m.years.includes(memberYear)) : [];
const memberDepts = [...new Set(yearMembers.map((m) => m.dept))]
  .sort((a, b) => deptRank(a) - deptRank(b) || a.localeCompare(b, "ja"))
  .map((dept) => ({ dept, count: yearMembers.filter((m) => m.dept === dept).length }));
const FACES = 8; // 並べる顔の数
const faces = yearMembers.slice(0, FACES);

const contact = await loadContact();
// ABOUT 欄に続けて並べるページ（無いページは飛ばす）
const aboutMore = (handaConfig.home.aboutMore ?? [])
  .map((t) => all.find((e) => e.data.title === t))
  .filter((e): e is (typeof all)[number] => Boolean(e));

const siteTitle = site?.title ?? "Home";
const siteDescription = site?.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// トップのスライド写真（Cosense の「トップ写真」ページ）。無ければ大きなロゴを出す
const slides = await loadSlides();
const heroLogo = existsSync(join(process.cwd(), "public", "logo-full.png")) ? `${base}/logo-full.png` : undefined;
---
<Layout title={siteTitle} description={siteDescription} hideToc>
  {/* トップでは、大きなロゴが見えている間はヘッダーの小さいロゴを隠す（重複して見えないように）。
      下にスクロールして大きなロゴが画面から消えると、ヘッダーのロゴがふわっと出る。 */}
  {slides.length > 0 ? (
    <section class="hero has-slides">
      <h1 class="visually-hidden">{siteTitle}</h1>
      <HeroSlides slides={slides} caption={siteDescription} />
    </section>
  ) : (
    <Fragment>
      <script is:inline>document.documentElement.classList.add("is-home", "hero-visible");</script>
      <section class="hero">
        {heroLogo ? <h1 class="hero-logo"><img src={heroLogo} alt={siteTitle} /></h1> : <h1 class="hero-title">{siteTitle}</h1>}
        {siteDescription && <p class="hero-desc">{siteDescription}</p>}
      </section>
    </Fragment>
  )}

  {sections.length === 0 && (
    <section class="recent-pages">
      <h2>Recent pages</h2>
      <ul>{all.slice(0, 20).map((entry) => <EntryCard entry={entry} />)}</ul>
    </section>
  )}

  {sections.map((s) => (
    <section class:list={["home-section", `is-${s.kind}`]}>
      {s.kind === "about" && s.entry && (
        <Fragment>
          <SectionHeader as="h2" en={s.en} title={s.entry.data.title} />
          {/* 概要：HAnDAプロジェクトとは＋handa.config.ts の home.aboutMore のページ（半田市とは・赤レンガ建物とは など） */}
          <AboutBlock entry={s.entry} heading={false} />
          {/* 学生チャレンジプロジェクトとは・半田市とは などのカード。1 枚ずつ見せて、左右の矢印かスワイプで送る */}
          {aboutMore.length > 0 && (
            <div class="carousel about-carousel" data-carousel style="--per: 1">
              <ul class="carousel-track about-cards">
                {aboutMore.map((e) => <li><AboutCard entry={e} href={`${s.href}#${encodeURIComponent(e.data.title)}`} /></li>)}
              </ul>
              <button type="button" class="carousel-btn is-prev" aria-label="前へ" hidden><span aria-hidden="true"></span></button>
              <button type="button" class="carousel-btn is-next" aria-label="次へ" hidden><span aria-hidden="true"></span></button>
            </div>
          )}
          {/* 「詳しく見る」は最後に 1 つだけ（概要ページに全部まとめて載っている） */}
          <a class="more-link about-all" href={s.href}>もっと読む <span aria-hidden="true">→</span></a>
        </Fragment>
      )}

      {s.kind === "blog" && (
        <Fragment>
          <SectionHeader as="h2" en={s.en} title={s.ja} lead={intros.blog} />
          {posts.length > 0
            ? <div class="carousel" data-carousel style="--per: 3"><ul class="card-grid carousel-track">{posts.slice(0, HOME_CARDS).map((e) => <Card entry={e} />)}</ul><button type="button" class="carousel-btn is-prev" aria-label="前へ" hidden><span aria-hidden="true"></span></button><button type="button" class="carousel-btn is-next" aria-label="次へ" hidden><span aria-hidden="true"></span></button></div>
            : <p class="home-empty">まだ記事がありません。</p>}
          <a class="more-link" href={s.href}>{s.ja}一覧へ <span aria-hidden="true">→</span></a>
        </Fragment>
      )}

      {s.kind === "works" && (
        <Fragment>
          <SectionHeader as="h2" en={s.en} title={s.ja} lead={intros.works} />
          {works.length > 0
            ? <div class="carousel" data-carousel style="--per: 3"><ul class="card-grid carousel-track">{works.slice(0, HOME_CARDS).map((e) => <Card entry={e} showDate={false} />)}</ul><button type="button" class="carousel-btn is-prev" aria-label="前へ" hidden><span aria-hidden="true"></span></button><button type="button" class="carousel-btn is-next" aria-label="次へ" hidden><span aria-hidden="true"></span></button></div>
            : <p class="home-empty">まだ活動が登録されていません。</p>}
          <a class="more-link" href={s.href}>{s.ja}一覧へ <span aria-hidden="true">→</span></a>
        </Fragment>
      )}

      {s.kind === "members" && (
        <Fragment>
          <SectionHeader as="h2" en={s.en} title={s.ja} lead={intros.members} />
          {yearMembers.length > 0 ? (
            <a class="member-teaser" href={s.href}>
              <span class="mt-count">
                <span class="mt-year">{memberYear}年度</span>
                <span class="mt-num">{yearMembers.length}<small>人</small></span>
              </span>
              <span class="mt-body">
                <span class="mt-faces" aria-hidden="true">
                  {faces.map((m) =>
                    m.entry.data.image
                      ? <img src={m.entry.data.image} alt="" loading="lazy" decoding="async" />
                      : (
                        <span class="mt-face">
                          <svg viewBox="0 0 64 64" fill="currentColor"><circle cx="32" cy="24" r="11" /><path d="M10 60c0-12.2 9.8-21 22-21s22 8.8 22 21z" /></svg>
                        </span>
                      ),
                  )}
                  {yearMembers.length > FACES && <span class="mt-face mt-more">+{yearMembers.length - FACES}</span>}
                </span>
                <span class="mt-depts">
                  {memberDepts.map((d) => <span class="mt-dept">{d.dept}<b>{d.count}</b></span>)}
                </span>
              </span>
              <span class="mt-arrow" aria-hidden="true">→</span>
            </a>
          ) : <p class="home-empty">まだメンバーが登録されていません。</p>}
          <a class="more-link" href={s.href}>{s.ja}一覧へ <span aria-hidden="true">→</span></a>
        </Fragment>
      )}

      {s.kind === "contact" && (
        <Fragment>
          <SectionHeader as="h2" en={s.en} title={s.ja} href={s.href} />
          {contact.accounts.length > 0 && (
            <ul class="home-accounts">
              {contact.accounts.map((a) => (
                <li>
                  {a.url
                    ? <a class:list={["home-account", `is-${a.service.toLowerCase()}`]} href={a.url} target="_blank" rel="noopener noreferrer"><b>{serviceMark(a.service) === a.service ? a.service : <Fragment><span aria-hidden="true">{serviceMark(a.service)}</span><span class="sr-only">{a.service}</span></Fragment>}</b>{a.handle && <span>@{a.handle}</span>}<span aria-hidden="true">↗</span></a>
                    : <span class:list={["home-account", "is-pending", `is-${a.service.toLowerCase()}`]}><b>{serviceMark(a.service) === a.service ? a.service : <Fragment><span aria-hidden="true">{serviceMark(a.service)}</span><span class="sr-only">{a.service}</span></Fragment>}</b><span>準備中</span></span>}
                </li>
              ))}
              {contact.mail?.href && (
                <li><a class="home-account is-mail" href={contact.mail!.href}><b>Mail</b><span>メールで問い合わせ</span></a></li>
              )}
            </ul>
          )}
        </Fragment>
      )}

      {s.kind === "page" && s.entry && (
        <Fragment>
          <SectionHeader as="h2" en={s.en} title={s.entry.data.title} lead={s.entry.data.summary} />
          <a class="more-link" href={s.href}>詳しく見る <span aria-hidden="true">→</span></a>
        </Fragment>
      )}
    </section>
  ))}
</Layout>

<script>
  // ABOUT・ブログ・活動のカードの左右送り（入りきらないときだけ矢印を出す）
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const list = root.querySelector<HTMLElement>(".carousel-track");
    const prev = root.querySelector<HTMLButtonElement>(".is-prev");
    const next = root.querySelector<HTMLButtonElement>(".is-next");
    if (!list || !prev || !next) return;
    const update = () => {
      const max = list.scrollWidth - list.clientWidth;
      const scrollable = max > 4;
      prev.hidden = next.hidden = !scrollable;
      prev.disabled = list.scrollLeft <= 4;
      next.disabled = list.scrollLeft >= max - 4;
    };
    const step = () => list.clientWidth + parseFloat(getComputedStyle(list).columnGap || "0");
    prev.addEventListener("click", () => list.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => list.scrollBy({ left: step(), behavior: "smooth" }));
    list.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });

  const hero = document.querySelector(".hero:not(.has-slides)");
  const root = document.documentElement;
  if (hero && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([e]) => root.classList.toggle("hero-visible", e.isIntersecting),
      { rootMargin: "-80px 0px 0px 0px" },
    ).observe(hero);
  } else if (hero) {
    root.classList.remove("hero-visible");
  }
</script>

<style is:global>
  html.is-home .site-brand {
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }
  html.is-home.hero-visible .site-brand {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
  }
</style>

<style>
  /* ABOUT 欄の最後の「もっと読む」（ほかの欄の「〇〇一覧へ」と同じ形） */
  .about-all { margin-top: 2rem; }
  /* カードの横送り（ABOUT は 1 枚、ブログ・活動は 3 枚ずつ表示。スマホは 1 枚） */
  .carousel { position: relative; }
  .about-carousel { margin-top: 2rem; }
  .carousel-track {
    --gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.5rem;
    display: grid;
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--gap) * (var(--per, 2) - 1)) / var(--per, 2));
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track > :global(li) { scroll-snap-align: start; min-width: 0; }
  @media (max-width: 900px) {
    .carousel[style*="--per: 3"] .carousel-track { grid-auto-columns: calc((100% - var(--gap)) / 2); }
  }
  /* スマホは矢印を出さず、次のカードを少しのぞかせてスワイプで送る */
  @media (max-width: 720px) {
    .carousel .carousel-track,
    .carousel[style*="--per: 3"] .carousel-track { grid-auto-columns: 86%; --gap: 0.75rem; }
    .carousel .carousel-btn { display: none; }
  }
  .carousel-btn {
    position: absolute;
    top: 38%;
    z-index: 2;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.12);
    cursor: pointer;
    transform: translateY(-50%);
    transition: border-color 0.15s var(--ease), opacity 0.2s var(--ease);
  }
  .carousel-btn:hover { border-color: var(--color-accent); }
  .carousel-btn[hidden] { display: none; }
  .carousel-btn:disabled { opacity: 0; pointer-events: none; }
  .carousel-btn.is-prev { left: -1.3rem; }
  .carousel-btn.is-next { right: -1.3rem; }
  .carousel-btn span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-top: 2px solid var(--color-text);
    border-right: 2px solid var(--color-text);
  }
  .carousel-btn.is-prev span { transform: translate(-30%, -50%) rotate(-135deg); }
  .carousel-btn.is-next span { transform: translate(-70%, -50%) rotate(45deg); }
  .carousel-btn:hover span { border-color: var(--color-accent); }


  /* スライドがあるときは、白いパネルの端から端まで写真を広げる */
  .hero.has-slides {
    max-width: none;
    margin: -5rem -3.5rem 1rem;
    padding: 0;
    border-bottom: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .hero.has-slides { margin: -2.5rem -1.25rem 0.5rem; }
  }
  .hero {
    padding: 1.5rem 0 3rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .hero-logo { margin: 0; line-height: 0; }
  .hero-logo img { width: min(100%, 560px); height: auto; }
  .hero-title { margin: 0; font-size: 2.5rem; }
  .hero-desc {
    margin: 1.5rem 0 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-soft);
  }

  .home-section { padding: 3rem 0; border-bottom: 1px solid var(--color-divider); }
  .home-section:last-child { border-bottom: none; }
  .home-section.is-link { display: none; }
  .home-empty { color: var(--color-text-muted); }

  /* MEMBERS 欄：最新年度の人数（大きな数字）・顔ぶれ・学科ごとの人数 */
  .member-teaser {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 1.6rem 4rem 1.6rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.15s var(--ease), box-shadow 0.2s var(--ease), transform 0.15s var(--ease);
  }
  .member-teaser:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    box-shadow: 0 8px 22px rgb(0 0 0 / 0.06);
  }
  .mt-count {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-right: 2rem;
    border-right: 1px solid var(--color-divider);
  }
  .mt-year {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .mt-num {
    font-family: "Oswald", var(--font-display);
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }
  .mt-num small {
    margin-left: 0.15em;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text);
  }
  .mt-body { display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
  /* 顔：少しずつ重ねて並べる */
  .mt-faces { display: flex; padding-left: 8px; }
  .mt-faces > * {
    width: 44px;
    height: 44px;
    margin-left: -8px;
    border-radius: 50%;
    border: 3px solid var(--color-bg);
    background: var(--color-bg-soft);
    object-fit: cover;
    flex: none;
    transition: transform 0.2s var(--ease);
  }
  .mt-face { display: grid; place-items: end center; overflow: hidden; color: var(--color-text-faint); }
  .mt-face svg { width: 80%; height: 80%; }
  .mt-faces > .mt-more {
    place-items: center;
    font-family: "Oswald", var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    background: var(--color-blue, #1658a0);
  }
  /* カーソルを乗せると、顔が順にちょっと跳ねる */
  .member-teaser:hover .mt-faces > * { transform: translateY(-3px); }
  .member-teaser:hover .mt-faces > :nth-child(2) { transition-delay: 0.03s; }
  .member-teaser:hover .mt-faces > :nth-child(3) { transition-delay: 0.06s; }
  .member-teaser:hover .mt-faces > :nth-child(4) { transition-delay: 0.09s; }
  .member-teaser:hover .mt-faces > :nth-child(5) { transition-delay: 0.12s; }
  .member-teaser:hover .mt-faces > :nth-child(6) { transition-delay: 0.15s; }
  .member-teaser:hover .mt-faces > :nth-child(7) { transition-delay: 0.18s; }
  .member-teaser:hover .mt-faces > :nth-child(n + 8) { transition-delay: 0.21s; }
  /* 学科ごとの人数 */
  .mt-depts { display: flex; flex-wrap: wrap; gap: 0.4rem 0.5rem; }
  .mt-dept {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .mt-dept b { font-family: "Oswald", var(--font-display); font-weight: 500; font-size: 0.95rem; }
  .mt-arrow {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    color: var(--color-accent);
    transition: transform 0.15s var(--ease);
  }
  .member-teaser:hover .mt-arrow { transform: translate(4px, -50%); }

  @media (max-width: 720px) {
    .member-teaser {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 1.3rem 1.25rem;
    }
    .mt-count {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: 0.75rem;
      padding: 0 0 1rem;
      border-right: none;
      border-bottom: 1px solid var(--color-divider);
    }
    .mt-num { font-size: 2.8rem; }
    .mt-faces > * { width: 38px; height: 38px; }
    .mt-arrow { top: 1.6rem; transform: none; }
    .member-teaser:hover .mt-arrow { transform: translateX(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .member-teaser:hover .mt-faces > * { transform: none; }
  }

  /* お問い合わせの概要：SNS アカウントのボタン */
  .home-accounts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .home-account {
    --c: var(--color-accent);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.15s var(--ease), filter 0.15s var(--ease);
  }
  /* 各サービスのイメージカラー */
  .home-account.is-x { --c: #000; }
  .home-account.is-instagram {
    --c: #d62976;
    background: linear-gradient(45deg, #feda75 0%, #fa7e1e 22%, #d62976 50%, #962fbf 75%, #4f5bd5 100%);
  }
  .home-account.is-tiktok { --c: #010101; }
  .home-account.is-x b { font-family: var(--font-sans); font-size: 1.15rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .home-account.is-tiktok b { text-shadow: -1.5px -1.5px 0 #25f4ee, 1.5px 1.5px 0 #fe2c55; }
  .home-account.is-youtube { --c: #ff0000; }
