---
import { getCollection } from "astro:content";
import { hasTag, path } from "@cosense-site-kit/theme-utils";
import { loadStructure } from "../lib/config";
import type { GetStaticPaths, PaginateFunction } from "astro";
import Card from "../components/Card.astro";
import Layout from "../components/Layout.astro";
import Pagination from "../components/Pagination.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BackLink from "../components/BackLink.astro";
import FiscalJump from "../components/FiscalJump.astro";
import { entryFiscalYear, fiscalId, fiscalLabel, groupByFiscalYear } from "../lib/fiscal";
import { homeBack } from "../lib/sections";
import { sectionInfo } from "../lib/sections";
import { POSTS_PER_PAGE } from "../constants";

// /posts/[...page] — paginated list of pages tagged with the .site posts tag.
// Page 1 is /posts; later pages are /posts/2, /posts/3, … The route always
// emits at least page 1 (a stub when posts aren't configured) so /posts never
// 404s.
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const structure = await loadStructure();
  const postTag = structure.posts?.tag;
  const all = await getCollection("pages");
  const posts = postTag
    ? all
        .filter((e) => hasTag(e.data.tags, postTag))
        .sort((a, b) => (b.data.publishedAt ?? "").localeCompare(a.data.publishedAt ?? ""))
    : [];

  if (posts.length === 0) {
    return [
      {
        params: { page: undefined },
        props: { entries: [], pageInfo: null, configured: Boolean(postTag) },
      },
    ];
  }

  // HAnDA: 年度ごとの区切り。各年度の最初の記事が何ページ目にあるかを調べて、
  // 「年度へ移動」のボタンからそのページのその年度の見出しへ飛べるようにする
  const fyOf = (e: (typeof posts)[number]) => entryFiscalYear(e.data);
  let index = 0;
  const yearPages = groupByFiscalYear(posts, (e) => entryFiscalYear(e.data)).map((g) => {
    const page = Math.floor(index / POSTS_PER_PAGE) + 1;
    index += g.items.length;
    return { year: g.year, page };
  });

  return (paginate as PaginateFunction)(posts, { pageSize: POSTS_PER_PAGE }).map((route) => ({
    params: route.params,
    props: {
      // ひとつ前のページの最後の記事の年度（このページの先頭が年度の途中かどうかを見るため）
      prevYear: route.props.page.start > 0 ? fyOf(posts[route.props.page.start - 1]) : undefined,
      yearPages,
      entries: route.props.page.data,
      pageInfo: {
        current: route.props.page.currentPage,
        last: route.props.page.lastPage,
        prevUrl: route.props.page.url.prev,
        nextUrl: route.props.page.url.next,
      },
      configured: true,
    },
  }));
};

type Entry = Awaited<ReturnType<typeof getCollection<"pages">>>[number];
const { entries, pageInfo, configured, prevYear, yearPages = [] } = Astro.props as {
  prevYear?: number;
  yearPages?: { year: number; page: number }[];
  entries: Entry[];
  pageInfo: { current: number; last: number; prevUrl?: string; nextUrl?: string } | null;
  configured: boolean;
};
const info = await sectionInfo("blog");

// HAnDA: 年度が変わるところに区切りの見出しを入れる。ページの先頭が年度の途中なら、
// その年度名も（リンク先にはしない見出しとして）出して、いま何年度の記事かわかるようにする
const current = pageInfo?.current ?? 1;
const jumpYears = yearPages.map(({ year, page }) => ({
  year,
  href: `${page === current ? "" : path(page === 1 ? "posts" : `posts/${page}`)}#${fiscalId(year)}`,
}));
let last = prevYear;
const rows = entries.map((entry, i) => {
  const year = entryFiscalYear(entry.data) ?? last;
  const starts = year !== undefined && year !== last; // その年度の最初の記事
  const divider = year !== undefined && (starts || i === 0) ? { year, anchor: starts } : undefined;
  last = year;
  return { entry, divider };
});
---
<Layout title={info.ja} description={info.intro} hideToc>
  <BackLink back={homeBack()} />
  <SectionHeader en={info.en} title={info.ja} lead={info.intro} />
  {configured ? (
    <section>
      {entries.length === 0 && <p class="summary">まだ記事がありません。</p>}
      <FiscalJump years={jumpYears} />
      <ul class="card-grid">
        {rows.map(({ entry, divider }) => (
          <Fragment>
            {divider && (
              <li class="fy-divider">
                <h2 class="fy-heading" id={divider.anchor ? fiscalId(divider.year) : undefined}>{fiscalLabel(divider.year)}</h2>
              </li>
            )}
            <Card entry={entry} />
          </Fragment>
        ))}
      </ul>
      {pageInfo && <Pagination {...pageInfo} />}
    </section>
  ) : (
    <p class="summary">ブログが設定されていません（.site の posts.tag を設定してください）。</p>
  )}
</Layout>
