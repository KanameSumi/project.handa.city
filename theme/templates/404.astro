---
// HAnDA: 見つからないページ（404）。赤レンガの壁から「レンガがひとつ抜け落ちた」絵で知らせる。
// - 壁は背景と同じイギリス積み。真ん中の1つが抜けて、下に落ちている
// - 落ちたレンガはつかんで動かせる。穴に戻すと、ぴたっとはまってホームへ移る
// - 文字は「404 NOT FOUND」と短い説明だけ。ホームへは、レンガを戻すか、クリックで移れる
// テーマ標準の注意点（そのまま）:
//  - data-pagefind-body を付けないので、検索の対象にならない
//  - 404 はどんな深い URL でも出るので、リンクは path() で絶対パスにする
//  - 見出しの目次は出さない（hideToc）
import { path } from "@cosense-site-kit/theme-utils";
import Layout from "../components/Layout.astro";


// 壁：6段。偶数段は長いレンガ、奇数段は短いレンガ（イギリス積み）。
// 3段目の真ん中のレンガだけ抜けている
const ROWS = 6;
const MISSING_ROW = 2;
const rows = Array.from({ length: ROWS }, (_, r) => {
  const long = r % 2 === 0;
  const count = long ? 6 : 12;
  return { long, bricks: Array.from({ length: count }, (_, i) => i), missing: r === MISSING_ROW ? Math.floor(count / 2) - 1 : -1 };
});
---
<Layout title="ページが見つかりません" hideToc>
  <section class="nf">

    <p class="nf-code">404</p>
    <h1 class="nf-title">NOT FOUND</h1>
    <p class="nf-lead">
      <span>レンガがひとつ抜けてしまったようです。</span>
      <span>ページが移動したか、</span><span>削除された可能性があります。</span>
    </p>

    <div class="nf-stage">
      <div class="nf-wall" aria-hidden="true">
        {rows.map((row) => (
          <div class:list={["nf-row", { "is-long": row.long }]}>
            {row.bricks.map((i) => <span class:list={["nf-brick", { "is-missing": i === row.missing }]} />)}
          </div>
        ))}
      </div>
      {/* 抜け落ちたレンガ（つかんで穴に戻せる） */}
      <button type="button" class="nf-fallen" aria-label="ホームへ戻る（レンガを穴に戻す）" data-home={path("")}></button>
    </div>
    <noscript><style>.nf-fallen { visibility: visible; }</style></noscript>

  </section>
</Layout>

<script>
  // 落ちたレンガのドラッグ。穴の近くで離すと、穴にはまってホームへ移る。
  // 遠くで離すと、元の場所へ戻る。キーボード・クリックだけでも（押すと）ホームへ移れる。
  const brick = document.querySelector<HTMLButtonElement>(".nf-fallen");
  const hole = document.querySelector<HTMLElement>(".nf-brick.is-missing");
  const stage = document.querySelector<HTMLElement>(".nf-stage");
  if (brick && hole && stage) {
    const home = brick.dataset.home ?? "/";

    // 落ちる前の位置＝穴。レンガを穴と同じ大きさにして、穴の真下に落ちて止まるようにする
    const place = () => {
      const h = hole.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      const holeLeft = h.left - s.left;
      const holeTop = h.top - s.top;
      const restLeft = holeLeft;
      const restTop = s.height - h.height - 8;
      brick.style.width = `${h.width}px`;
      brick.style.left = `${restLeft}px`;
      brick.style.top = `${restTop}px`;
      brick.style.setProperty("--fx", `${holeLeft - restLeft}px`);
      brick.style.setProperty("--fy", `${holeTop - restTop}px`);
    };
    place();
    brick.classList.add("is-ready"); // ここで落ちる動きが始まる
    window.addEventListener("resize", () => { if (!brick.classList.contains("is-placed")) place(); });
    let sx = 0, sy = 0, dx = 0, dy = 0, dragging = false, moved = false, done = false;

    // 穴の中心と、いまのレンガの中心の差
    const gap = () => {
      const h = hole.getBoundingClientRect();
      const b = brick.getBoundingClientRect();
      return { x: h.left + h.width / 2 - (b.left + b.width / 2), y: h.top + h.height / 2 - (b.top + b.height / 2) };
    };
    const near = () => {
      const g = gap();
      return Math.hypot(g.x, g.y) < 34;
    };

    const goHome = () => {
      if (done) return;
      done = true;
      // 穴の位置・大きさにぴったり合わせて、まっすぐにはめる
      const h = hole.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      brick.classList.add("is-placed");
      brick.style.left = `${h.left - s.left}px`;
      brick.style.top = `${h.top - s.top}px`;
      brick.style.width = `${h.width}px`;
      brick.style.translate = "0 0";
      hole.classList.add("is-filled");
      stage.classList.add("is-done");
      setTimeout(() => { location.href = home; }, 750);
    };

    brick.addEventListener("pointerdown", (e) => {
      if (done) return;
      dragging = true;
      moved = false;
      sx = e.clientX - dx;
      sy = e.clientY - dy;
      brick.setPointerCapture(e.pointerId);
      brick.classList.add("is-dragging");
      document.documentElement.classList.add("nf-dragging");
    });
    brick.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      dx = e.clientX - sx;
      dy = e.clientY - sy;
      if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
      brick.style.translate = `${dx}px ${dy}px`;
      hole.classList.toggle("is-near", near());
    });
    const drop = () => {
      if (!dragging) return;
      dragging = false;
      brick.classList.remove("is-dragging");
      document.documentElement.classList.remove("nf-dragging");
      hole.classList.remove("is-near");
      if (near()) return goHome();
      // 遠ければ元の場所へ戻る
      dx = 0;
      dy = 0;
      brick.style.translate = "0 0";
    };
    brick.addEventListener("pointerup", drop);
    brick.addEventListener("pointercancel", drop);
    // ドラッグせずに押した（キーボードの Enter・スペースも）ときもホームへ
    brick.addEventListener("click", () => { if (!moved) goHome(); });

    // ホームから「戻る」で帰ってきたとき、ブラウザはレンガがはまったままの画面を
    // そのまま復元する（bfcache）。最初の状態に戻して、もう一度落ちるところから始める
    const reset = () => {
      done = false;
      dragging = false;
      dx = 0;
      dy = 0;
      brick.classList.remove("is-placed", "is-dragging", "is-ready");
      hole.classList.remove("is-filled", "is-near");
      stage.classList.remove("is-done");
      document.documentElement.classList.remove("nf-dragging");
      brick.style.translate = "";
      place();
      void brick.offsetWidth; // アニメーションを最初からやり直させる
      brick.classList.add("is-ready");
    };
    window.addEventListener("pageshow", (e) => { if (e.persisted) reset(); });
  }
</script>

<style>
  .nf {
    text-align: center;
    padding: 2rem 0 3rem;
  }

  /* ---- 壁 ---- */
  .nf-stage {
    --h: 22px; /* レンガの高さ */
    --gap: 5px; /* 目地 */
    position: relative;
    width: min(100%, 420px);
    margin: 0 auto;
    padding-bottom: 50px; /* 落ちたレンガのぶん */
  }
  .nf-wall {
    overflow: hidden;
    /* 左右の端はぼかして、壁の一部を切り取ったように */
    -webkit-mask: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
    mask: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
  }
  .nf-row {
    display: flex;
    gap: var(--gap);
    margin-bottom: var(--gap);
    margin-left: calc(var(--h) * -1); /* 段ごとに少しずらして、はみ出しは切る */
    margin-right: calc(var(--h) * -1);
  }
  .nf-row.is-long { margin-left: calc(var(--h) * -2); }
  .nf-brick {
    flex: 1;
    height: var(--h);
    border-radius: 3px;
    background: #ecc3c7;
  }
  /* 抜けたところ：奥の暗がり */
  .nf-brick.is-missing {
    background: #c99299;
    box-shadow: inset 0 4px 7px rgb(80 10 20 / 0.45);
    outline: 2px dashed transparent;
    outline-offset: 2px;
    animation: nf-hole 2.4s ease-in-out infinite;
  }
  /* 抜けた場所を、赤い点線でゆっくり点滅させて示す */
  @keyframes nf-hole {
    50% { outline-color: rgb(214 21 46 / 0.55); }
  }
  /* 抜け落ちたレンガ：ロゴの赤。読み込むと上から落ちてきて、傾いて止まる。つかんで動かせる */
  .nf-fallen {
    position: absolute;
    left: calc(50% - 20px);
    top: calc(100% - var(--h) - 8px);
    width: 64px;
    height: var(--h);
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: var(--color-accent);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.15), 0 6px 10px -4px rgb(0 0 0 / 0.3);
    cursor: grab;
    touch-action: none; /* スマホで指で動かせるように */
    transition: translate 0.45s cubic-bezier(0.3, 1.5, 0.5, 1), box-shadow 0.2s ease;
    visibility: hidden; /* 位置が決まるまで隠す（スクリプトが is-ready を付ける） */
  }
  /* 穴から真下へストンと落ち、下で軽く弾んで、少し傾いて止まる */
  .nf-fallen.is-ready {
    visibility: visible;
    animation:
      nf-fall 0.55s cubic-bezier(0.55, 0, 0.8, 0.4) 0.5s both,
      nf-land 0.5s ease-out 1.05s forwards;
    /* 後ろのアニメーションほど優先されるので、始まる前の状態（穴の中）を持つのは「落ちる」だけにしている */
  }
  /* つかんでいる間は、本文の白いパネルごと一番手前に出して、
     右端のスクロールバーなどより上をレンガが通るようにする */
  :global(html.nf-dragging .site-main) { position: relative; z-index: 40; }
  .nf-fallen:hover { box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.15), 0 10px 16px -6px rgb(0 0 0 / 0.35); }
  .nf-fallen:focus-visible { outline: 2px solid var(--color-blue, #1658a0); outline-offset: 3px; }
  /* つかんでいる間：指にくっついて、少し持ち上がる */
  .nf-fallen.is-dragging {
    cursor: grabbing;
    transition: box-shadow 0.2s ease;
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.15), 0 14px 20px -6px rgb(0 0 0 / 0.35);
  }
  /* 穴にはまったとき：まっすぐになって、穴の大きさにぴったり */
  .nf-fallen.is-placed {
    animation: none;
    transform: none;
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.12);
    transition: left 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2), top 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2),
      width 0.35s ease, transform 0.35s ease, translate 0.35s ease;
    cursor: default;
  }
  @keyframes nf-fall {
    from { transform: translateY(var(--fy)) rotate(0deg); }
    to { transform: translateY(0) rotate(0deg); }
  }
  @keyframes nf-land {
    0% { transform: translateY(0) rotate(0deg); }
    45% { transform: translateY(-6px) rotate(-5deg); }
    100% { transform: translateY(0) rotate(-9deg); }
  }
  /* レンガが近づいたら、穴を光らせて「ここ」と知らせる */
  .nf-brick.is-missing.is-near {
    animation: none;
    outline: 2px solid var(--color-accent);
  }
  .nf-brick.is-missing.is-filled { animation: none; outline: none; }
  /* はまったら、壁全体がぽんと弾む */
  .nf-stage.is-done .nf-wall { animation: nf-bump 0.4s ease 0.3s; }
  @keyframes nf-bump { 50% { transform: scale(1.03); } }

  /* ---- 文字 ---- */
  .nf-code {
    margin: 0;
    font-family: "Oswald", var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .nf-title {
    margin: 0.5rem 0 0.75rem;
    font-family: "Oswald", var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }
  .nf-lead {
    max-width: 24em;
    margin: 0 auto 2.5rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.9;
  }
  /* 文の途中で折り返さないよう、区切りごとにまとめる */
  .nf-lead span { display: inline-block; }
  @media (max-width: 720px) {
    .nf-code { font-size: 3.6rem; }
    .nf-title { font-size: 1.3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-fallen.is-ready, .nf-brick.is-missing, .nf-stage.is-done .nf-wall { animation: none; }
  }
</style>
