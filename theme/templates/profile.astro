---
import type { CollectionEntry } from "astro:content";
import PageContent from "../components/Content.astro"; // HAnDA: 外部 URL をリンクカードにする版
import BackLink from "../components/BackLink.astro";
import Layout from "../components/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import WorkChips from "../components/WorkChips.astro";
import { MEMBER_TAG, backLinkFor, loadSections, worksForMember } from "../lib/sections";
import { displayName } from "../lib/members";

// Profile template: a slim hero band over the body, no tag chips, and a
// "more pages" footer pointing back into the rest of the site. Suitable for
// About / Members / Bio pages.
//
// Opt in by tagging the Cosense page with `#template/profile`, or by mapping
// the title in `.site` site.yaml:
//
//   templates:
//     "About Me": profile

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const page = entry.data;
// HAnDA: ナビに載っているページなら英語ラベルを、詳細ページなら一覧へ戻るリンクを出す
const navSection = (await loadSections()).find((s) => s.entry?.data.slug === page.slug);
const back = await backLinkFor(page.tags);
// メンバーページなら、関わった活動・成果をタグで出す
const isMember = page.tags.some((t) => MEMBER_TAG.test(t));
const memberWorks = isMember ? await worksForMember(entry) : [];
// 見出しに出す名前（メンバーは名前の後ろの（学科）などを出さない）
const heading = isMember ? displayName(page.title) : page.title;

// 本文に活動へのリンクだけの行がある場合、下の WORKS タグと重複するので本文からは消す
const workTitles = new Set(memberWorks.map((w) => w.data.title.trim().toLowerCase()));
type Inline = { type: string; value?: string; title?: string; children?: Inline[] };
const onlyWorkLinks = (nodes: Inline[] | undefined): boolean => {
  const meaningful = (nodes ?? []).filter((n) => !(n.type === "text" && !(n.value ?? "").trim()));
  return (
    meaningful.length > 0 &&
    meaningful.every((n) => n.type === "pageLink" && workTitles.has((n.title ?? "").trim().toLowerCase()))
  );
};
// メンバーページ：学科・学年の行（「情報科学科 ３年」など）は、Cosense で写真の上に書いても
// 下に書いても、いつも名前のすぐ下に出す（本文からは外す）。読み取り方は lib/members.ts と同じ
const DEPT_LINE = /^(.*?)\s*(M|D|修士|博士)?\s*(\d)\s*年/i;
const inlineText = (nodes: Inline[] | undefined): string =>
  (nodes ?? []).map((n) => (n.type === "text" ? n.value ?? "" : n.type === "pageLink" ? n.title ?? "" : inlineText(n.children))).join("");
let deptLine: string | undefined;
let bodyBlocks = page.blocks;
if (isMember) {
  // 先頭のほう（写真や空行をはさんでも 4 ブロック目まで）にある、短い 1 行だけを対象にする
  const i = page.blocks.slice(0, 4).findIndex((b) => {
    if (b.type !== "paragraph" || !("children" in b)) return false;
    const t = inlineText(b.children as Inline[]).normalize("NFKC").trim();
    return t.length > 0 && t.length <= 40 && DEPT_LINE.test(t);
  });
  if (i >= 0) {
    deptLine = inlineText((page.blocks[i] as { children?: Inline[] }).children).trim();
    bodyBlocks = page.blocks.filter((_, j) => j !== i);
  }
}

const blocks = workTitles.size
  ? bodyBlocks.filter((b) => !(("children" in b) && (b.type === "paragraph" || b.type === "list") && onlyWorkLinks(b.children as Inline[])))
  : bodyBlocks;
---
<Layout title={heading} description={page.summary} image={page.image} ogType="article" sourceUrl={page.sourceUrl}>
  <article class="profile" data-pagefind-body>
    <BackLink back={back} />
    <SectionHeader en={navSection?.en ?? back?.en} title={heading} lead={deptLine} />

    <PageContent blocks={blocks} />

    {/* メンバーページ：関わった活動（名前・写真・本文の下に表示） */}
    {memberWorks.length > 0 && (
      <div class="profile-works"><WorkChips works={memberWorks} label="Works" /></div>
    )}

    {/* 一覧へ戻るリンクは左上（BackLink）の1つだけ。Cosense の元ページへのリンクはフッターに出す */}
  </article>
</Layout>

<style>
  .profile-works { margin: 2rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--color-divider); }
  .profile-hero {
    text-align: center;
    padding: 2.5rem 1rem 2rem;
    border-bottom: 1px solid var(--color-divider);
    margin-bottom: 2.5rem;
  }
  .profile-hero h1 {
    font-size: 2.5rem;
    margin: 0 0 0.625rem;
    letter-spacing: 0.06em;
  }
  .profile-summary {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    max-width: 36rem;
    margin: 0 auto;
    line-height: 1.55;
  }
</style>
